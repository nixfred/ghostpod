# Tailscale (optional)
# When set, Caddy joins your tailnet and gets a real TLS cert automatically.
# When unset, Caddy uses a self-signed internal CA (run `caddy trust` to install
# the CA on each device, or accept the browser warning).
#
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral key so the node re-auths on redeploy.
TS_AUTHKEY=

# Tailnet hostname (must match what you set in the Tailscale admin console)
TS_HOSTNAME=ghostpod

# LAN mode only: the IP or hostname browsers will use to reach this service.
# Caddy issues its internal TLS cert with this as the Subject Alternative Name.
# If you set up a local DNS entry (e.g. terminal.lan), use that here instead.
LAN_HOST=192.168.1.100

# BasicAuth credentials
# Generate the password hash:
#   docker run --rm caddy:latest caddy hash-password --plaintext 'yourpassword'
ADMIN_USER=admin
# Leave empty to start without auth (safe for initial deploy — set before exposing the service).
# Generate a hash: docker run --rm caddy:latest caddy hash-password --plaintext 'yourpassword'
# Escape every $ in the hash as $$ so docker-compose doesn't expand it as a variable.
ADMIN_PASSWORD_HASH=

# Signs session cookies — generate with: openssl rand -hex 32
# If unset, a random key is generated at startup (sessions invalidated on restart).
SECRET_KEY=

# Optional: enables passwordless SSH from inside sessions.
# Absolute host path containing id_ed25519, id_ed25519.pub, and optionally
# config / known_hosts. Each session bind-mounts this directory read-only;
# terminal/entrypoint.sh copies the files into the session user's ~/.ssh
# with correct permissions.
# Leave empty to disable. Example: SSH_KEYS_HOST_DIR=${PWD}/ghostpod-ssh
SSH_KEYS_HOST_DIR=

# Persistent sessions. Empty (default) keeps ghostpod fully ephemeral: every
# connection gets a fresh container and closing the tab destroys it.
#
# Set to 1 and a disconnect no longer ends the session. Your browser gets a
# long-lived cookie, the container is named after it and left running, and the
# shell runs inside tmux, so reopening the tab reattaches to the same shell with
# the same scrollback and the same running processes.
#
# This is what makes ghostpod usable from a phone: iOS suspends any backgrounded
# tab and closes the WebSocket, so without this, glancing at another app for a
# moment destroys whatever you were doing.
#
# Trade-off: a held container outlives the moment its mounted SSH identity was
# needed, so keep the idle timeout no longer than you need.
PERSIST_SESSIONS=

# Seconds a disconnected session is held before it is reaped. Default 14400 (4h).
SESSION_IDLE_TIMEOUT=
